<div data-hf-id="hf-56l9" class="kicker">01 / SPATIAL DESKTOP</div><div data-hf-id="hf-sko8" class="index">KronTerm OS</div><div data-hf-id="hf-sogq" class="line"></div><div data-hf-id="hf-3bml" class="os-title">OS <span data-hf-id="hf-zz6t" class="lime">MODE.</span></div>
<div data-hf-id="hf-tan6" class="stage"><div data-hf-id="hf-iuf7" class="rig" id="os-rig"><div data-hf-id="hf-qqd9" class="slab" id="os-slab"><div data-hf-id="hf-c5je" class="edge e4"></div><div data-hf-id="hf-vlfh" class="edge e3"></div><div data-hf-id="hf-utro" class="edge e2"></div><div data-hf-id="hf-3hnj" class="edge e1"></div><div data-hf-id="hf-ce6r" class="face"><video data-hf-id="hf-a1wm" id="desktop-motion" class="clip" src="assets/os-motion.mp4" data-start="3.01" data-duration="5.21" data-track-index="1" muted playsinline></video></div></div></div></div>
<div data-hf-id="hf-dhmy" class="cap" id="os-caption">A workspace with room to move.</div><div data-hf-id="hf-aasc" class="foot">YOUR TOOLS. IN YOUR SPACE.</div><div data-hf-id="hf-x1wo" class="view-label">ACTUAL PRODUCT FOOTAGE</div>
</div></section>
<section data-hf-id="hf-l78t" id="focus" class="clip" data-start="8.22" data-duration="4.89" data-track-index="0"><div data-hf-id="hf-i7rz" class="content">
<div data-hf-id="hf-liz5" class="kicker">02 / BRING WORK INTO FOCUS</div><div data-hf-id="hf-pa4t" class="index">Terminal / Browser / Editor</div><div data-hf-id="hf-t2rr" class="line"></div>
<div data-hf-id="hf-6flw" class="scene-title focus-title"><span data-hf-id="hf-w915" id="focus-a">BRING WORK</span><span data-hf-id="hf-74m3" id="focus-b" class="lime">INTO FOCUS.</span></div>
<div data-hf-id="hf-xa86" class="stage"><div data-hf-id="hf-8szh" class="rig" id="focus-rig"><div data-hf-id="hf-2eiq" class="slab" id="focus-back"><div data-hf-id="hf-jrcj" class="face"><img data-hf-id="hf-wugy" src="assets/os-desktop.png"></div></div><div data-hf-id="hf-27qs" class="slab" id="focus-front"><div data-hf-id="hf-2f2m" class="edge e4"></div><div data-hf-id="hf-uo98" class="edge e2"></div><div data-hf-id="hf-jd1i" class="face"><img data-hf-id="hf-snuj" src="assets/editor-cutout.png"></div></div></div></div>
<div data-hf-id="hf-ky0m" class="foot">ONE PERSISTENT WORKSPACE.</div><div data-hf-id="hf-n4rc" class="view-label">OS MODE / CLOSE-UP</div>
</div></section>
<section data-hf-id="hf-u9go" id="hud" class="clip" data-start="13.11" data-duration="5.44" data-track-index="0"><div data-hf-id="hf-htgy" class="content">
<div data-hf-id="hf-5uii" class="kicker">03 / HERMES HUD</div><div data-hf-id="hf-s49s" class="index">Agent control</div><div data-hf-id="hf-th2s" class="line"></div><div data-hf-id="hf-1r77" class="hud-copy"><span data-hf-id="hf-idn5" id="hud-a">YOUR AGENT.</span><span data-hf-id="hf-bjfk" id="hud-b" class="lime">WITHIN REACH.</span></div>
<div data-hf-id="hf-xoj7" class="stage"><div data-hf-id="hf-rhqe" class="rig" id="hud-rig"><div data-hf-id="hf-6yg9" class="hud-shell" id="hud-object"><div data-hf-id="hf-o5mx" class="edge hud-edge e4"></div><div data-hf-id="hf-da5a" class="edge hud-edge e3"></div><div data-hf-id="hf-h89b" class="edge hud-edge e2"></div><div data-hf-id="hf-8kdg" class="edge hud-edge e1"></div><div data-hf-id="hf-iyqh" class="face"><img data-hf-id="hf-614o" src="assets/hud.png"></div></div></div></div>
<div data-hf-id="hf-qr8m" class="hud-caption">Ask. Review. Keep moving.</div><div data-hf-id="hf-3bv4" class="callout" id="hud-callout">REAL HUD / REAL FILE CHANGE</div><div data-hf-id="hf-zg8r" class="foot">CONTROL STAYS IN YOUR FIELD OF VIEW.</div>
</div></section>
