<div data-hf-id="hf-hfog" class="kicker">04 / CONNECTED WORKSPACE</div><div data-hf-id="hf-9nj6" class="index">OS + HUD</div><div data-hf-id="hf-tvdt" class="line"></div><div data-hf-id="hf-rlm5" class="join-title"><span data-hf-id="hf-gwkb">ONE FIELD</span><span data-hf-id="hf-02se" class="lime">OF VIEW.</span></div>
<div data-hf-id="hf-y2u8" class="stage"><div data-hf-id="hf-t991" class="rig" id="join-rig"><div data-hf-id="hf-mexp" class="slab" id="join-desktop"><div data-hf-id="hf-2tdn" class="edge e4"></div><div data-hf-id="hf-thc5" class="edge e2"></div><div data-hf-id="hf-ikfg" class="face"><img data-hf-id="hf-speu" src="assets/os-desktop.png"></div></div><div data-hf-id="hf-8otd" class="end-hud" id="join-hud"><div data-hf-id="hf-rkal" class="edge hud-edge e4"></div><div data-hf-id="hf-i64f" class="face"><img data-hf-id="hf-598w" src="assets/hud.png"></div></div></div></div><div data-hf-id="hf-a7uq" class="foot">KronTerm / PRIVATE BETA</div>
</div></section>
<section data-hf-id="hf-5lff" id="end" class="clip" data-start="21" data-duration="3" data-track-index="0"><div data-hf-id="hf-k7b4" class="content">
<div data-hf-id="hf-5xju" class="kicker">YOUR WORKSPACE. YOUR ELEMENT.</div><div data-hf-id="hf-t18i" class="index">KronTerm</div><div data-hf-id="hf-u9ou" class="line"></div><h1 data-hf-id="hf-bmd2" class="end-title">KronTerm<span data-hf-id="hf-uvz8" class="lime">.</span></h1><div data-hf-id="hf-xgvt" class="end-sub">Work in your element.</div><div data-hf-id="hf-w9ld" class="end-label">PRIVATE BETA</div>
<div data-hf-id="hf-vap1" class="stage"><div data-hf-id="hf-277e" class="rig" id="end-rig"><div data-hf-id="hf-87fi" class="end-plane"><div data-hf-id="hf-37oo" class="edge e4"></div><div data-hf-id="hf-tvn6" class="edge e2"></div><div data-hf-id="hf-hrte" class="face"><img data-hf-id="hf-t3pv" src="assets/os-desktop.png"></div></div><div data-hf-id="hf-sers" class="end-hud" id="end-hud"><div data-hf-id="hf-sr7o" class="edge hud-edge e4"></div><div data-hf-id="hf-hdid" class="face"><img data-hf-id="hf-42bt" src="assets/hud.png"></div></div></div></div><div data-hf-id="hf-1rb6" class="foot">THE COMMAND CENTER FOR HUMAN + AGENT WORK</div><div data-hf-id="hf-qiqf" class="micro">OS MODE + HERMES HUD</div>
</div></section>
<audio data-hf-id="hf-r9mp" id="music" src="assets/music.mp3" data-start="0" data-duration="24" data-track-index="10" data-volume="0.62" data-automation='{"version":1,"lanes":[{"target":"volume","points":[{"t":0,"v":0},{"t":0.3,"v":0.62},{"t":21.8,"v":0.62},{"t":24,"v":0}]}]}'></audio>
<audio data-hf-id="hf-qiob" id="hit-open" src="assets/impact.ogg" data-start="3.01" data-duration="0.51" data-track-index="11" data-volume="0.4"></audio>
<audio data-hf-id="hf-ul2e" id="hit-join" src="assets/impact.ogg" data-start="18.55" data-duration="0.51" data-track-index="11" data-volume="0.35"></audio>
<audio data-hf-id="hf-71bb" id="hud-switch" src="assets/switch.ogg" data-start="13.11" data-duration="0.5" data-track-index="12" data-volume="0.3"></audio>
</div>
<script>
const tl=gsap.timeline({paused:true});
tl.set('#os-content',{opacity:1},3.01).set('#os-content',{opacity:0},8.22);
tl.fromTo('.hook-top .word',{y:180,rotationX:-70,opacity:0},{y:0,rotationX:0,opacity:1,duration:.55,stagger:.1,ease:'power4.out'},.05);
tl.fromTo('.hook-bottom .word',{x:400,opacity:0},{x:0,opacity:1,duration:.55,stagger:.14,ease:'expo.out'},.4);
tl.fromTo('.hook-rule',{scaleX:0},{scaleX:1,duration:.7,ease:'power3.inOut'},.65);
tl.fromTo('.hook-note',{y:25,opacity:0},{y:0,opacity:1,duration:.35},.85);
tl.to('.hook-top',{x:-1500,duration:.46,ease:'power3.in'},2.55).to('.hook-bottom',{x:1650,duration:.46,ease:'power3.in'},2.55);
// Beat-grid: desktop opens at 3.01; focus at 8.22; HUD at 13.11.
tl.fromTo('#os-rig',{x:260,y:300,z:-1100,rotationX:35,rotationY:-30,rotationZ:-8},{x:140,y:100,z:-280,rotationX:13,rotationY:-13,rotationZ:-3,duration:1.15,ease:'power3.out'},3.01);
tl.to('#os-rig',{x:60,y:165,z:-280,rotationX:2,rotationY:7,rotationZ:1,duration:3.25,ease:'sine.inOut'},4.16);
tl.to('#os-rig',{x:-90,y:130,z:-180,rotationX:0,rotationY:0,rotationZ:0,duration:.81,ease:'power3.inOut'},7.41);
tl.fromTo('.os-title',{x:-450,opacity:0},{x:0,opacity:1,duration:.55,ease:'expo.out'},3.01);
tl.fromTo('#os-caption',{y:40,opacity:0},{y:0,opacity:1,duration:.5,ease:'power2.out'},3.55);
tl.fromTo('#focus-rig',{x:380,y:270,z:-900,rotationX:18,rotationY:-31,rotationZ:5},{x:230,y:180,z:-570,rotationX:10,rotationY:-17,rotationZ:0,duration:1,ease:'power3.out'},8.22);
tl.fromTo('#focus-front',{z:220,x:90,y:60},{z:360,x:130,y:80,duration:2.1,ease:'sine.inOut'},8.22);
tl.fromTo('#focus-back',{x:-220,y:-50,z:-350,rotationY:12},{x:-300,y:-90,z:-450,rotationY:18,duration:3.5,ease:'sine.inOut'},8.22);
tl.fromTo('#focus-a',{x:-500,opacity:0},{x:0,opacity:1,duration:.48,ease:'expo.out'},8.22);
tl.fromTo('#focus-b',{x:500,opacity:0},{x:0,opacity:1,duration:.48,ease:'expo.out'},8.46);
tl.to('#focus-rig',{x:40,y:140,z:-180,rotationX:0,rotationY:0,duration:1.8,ease:'power2.inOut'},11.2);
tl.to('.focus-title',{y:-80,opacity:0,duration:.45},12.45);
tl.fromTo('#hud-a',{y:90,opacity:0},{y:0,opacity:1,duration:.48,ease:'power4.out'},13.11);
tl.fromTo('#hud-b',{x:-400,opacity:0},{x:0,opacity:1,duration:.5,ease:'power4.out'},13.35);
tl.fromTo('#hud-rig',{x:550,y:360,z:-650,rotationX:48,rotationY:-28,rotationZ:-12},{x:120,y:150,z:-100,rotationX:16,rotationY:-13,rotationZ:-3,duration:1.1,ease:'power3.out'},13.11);
tl.to('#hud-rig',{x:60,y:65,z:80,rotationX:3,rotationY:6,rotationZ:0,duration:2.85,ease:'sine.inOut'},14.21);
tl.to('#hud-rig',{x:100,y:80,z:40,rotationX:-6,rotationY:15,rotationZ:2,duration:1.49,ease:'sine.inOut'},17.06);
tl.fromTo('#hud-callout',{x:70,opacity:0},{x:0,opacity:1,duration:.45,ease:'power2.out'},14.2);
// Beat-locked: the full workspace returns on the 18.55s strong cue.
tl.fromTo('#join-rig',{x:450,y:240,z:-950,rotationX:25,rotationY:-30,rotationZ:4},{x:270,y:150,z:-470,rotationX:10,rotationY:-14,rotationZ:0,duration:.7,ease:'power4.out'},18.55);
tl.fromTo('#join-hud',{z:650,x:-140,y:20},{z:320,x:0,y:0,duration:.8,ease:'power3.out'},18.55);
tl.to('#join-rig',{x:230,y:145,z:-390,rotationX:7,rotationY:-9,duration:1.75,ease:'sine.inOut'},19.25);
tl.fromTo('.join-title span',{x:-350,opacity:0},{x:0,opacity:1,duration:.5,stagger:.12,ease:'expo.out'},18.55);
tl.fromTo('#end-rig',{x:440,y:210,z:-620,rotationX:10,rotationY:-21,rotationZ:2},{x:440,y:180,z:-530,rotationX:6,rotationY:-13,rotationZ:0,duration:.85,ease:'power3.out'},21);
tl.fromTo('#end-hud',{z:470,x:-100},{z:340,x:-20,duration:.85,ease:'power3.out'},21);
tl.fromTo('.end-title',{x:-130,opacity:0},{x:0,opacity:1,duration:.55,ease:'power4.out'},21);
tl.fromTo('.end-sub',{y:35,opacity:0},{y:0,opacity:1,duration:.45,ease:'power2.out'},21.25);
for(let i=0;i<bassFrames.length;i++){
    tl.to('.line',{opacity:.55+bassFrames[i]*.4,duration:1/30,ease:'none'},i/30);
}
window.__timelines['kronterm-kinetic']=tl;
</script></body></html>
