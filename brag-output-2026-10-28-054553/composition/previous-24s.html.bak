<style>
@font-face{font-family:Inter;src:url(assets/inter.woff2)}
*{box-sizing:border-box}body{margin:0;background:#060708;color:#f5f5ef;font-family:Inter,sans-serif}#root{width:100%;height:100%;position:relative;overflow:hidden;background:#060708}.clip{position:absolute;inset:0} .content{position:absolute;inset:0;overflow:hidden}.kicker{position:absolute;left:80px;top:54px;font-size:24px;font-weight:600;letter-spacing:1px}.index{position:absolute;right:80px;top:54px;font-size:24px;color:#b7bab4}.foot{position:absolute;left:80px;bottom:48px;font-size:23px;color:#b7bab4}.lime{color:#a3e635}.line{position:absolute;left:80px;right:80px;top:99px;height:2px;background:#444a41}.scene-title{position:absolute;left:80px;top:135px;margin:0;font-size:110px;line-height:.95;letter-spacing:-7px;font-weight:850;z-index:5}.scene-title span{display:block}.cap{position:absolute;left:85px;bottom:110px;font-size:30px;letter-spacing:-.7px;z-index:5}.stage{position:absolute;inset:0;perspective:1700px;perspective-origin:50% 50%;overflow:hidden}.rig{position:absolute;left:960px;top:540px;transform-style:preserve-3d}.slab{position:absolute;left:-710px;top:-400px;width:1420px;height:800px;transform-style:preserve-3d}.face{position:absolute;inset:0;border:2px solid #62695c;border-radius:18px;overflow:hidden;background:#131715;backface-visibility:hidden}.face img,.face video{width:100%;height:100%;object-fit:cover;display:block}.edge{position:absolute;inset:0;border-radius:18px;background:#242c23;border:1px solid #738663}.e1{transform:translateZ(-8px)}.e2{transform:translateZ(-16px)}.e3{transform:translateZ(-24px)}.e4{transform:translateZ(-32px)}.face{transform:translateZ(1px)}.hook-top{position:absolute;left:80px;top:194px;font-size:220px;letter-spacing:-15px;line-height:.85;font-weight:900}.hook-bottom{position:absolute;left:80px;top:423px;font-size:204px;letter-spacing:-15px;line-height:.9;font-weight:900}.hook-bottom span{display:inline-block}.hook-note{position:absolute;left:85px;top:780px;font-size:31px}.hook-rule{position:absolute;left:86px;top:727px;width:1748px;height:12px;background:#a3e635;transform-origin:left center}.os-title{position:absolute;left:70px;top:122px;font-size:200px;letter-spacing:-13px;line-height:1;font-weight:900;z-index:0}.view-label{position:absolute;right:80px;bottom:48px;font-size:23px;color:#b7bab4}.focus-title{top:145px;font-size:108px}.hud-shell{position:absolute;left:-560px;top:-130px;width:1120px;height:418px;transform-style:preserve-3d}.hud-shell .face{border-color:#a3e635;border-radius:24px}.hud-shell img{object-fit:fill}.hud-edge{background:#414c28;border-color:#a3e635}.hud-copy{position:absolute;left:80px;top:153px;font-size:117px;line-height:.97;letter-spacing:-7px;font-weight:850;z-index:6}.hud-copy span{display:block}.hud-caption{position:absolute;left:85px;bottom:125px;font-size:30px}.callout{position:absolute;right:110px;bottom:150px;font-size:25px;color:#a3e635}.join-title{position:absolute;left:80px;top:147px;font-size:117px;letter-spacing:-8px;font-weight:850;z-index:5;line-height:.95}.join-title span{display:block}.end-title{position:absolute;left:80px;top:135px;font-size:155px;letter-spacing:-9px;font-weight:850;margin:0}.end-sub{position:absolute;left:86px;top:330px;font-size:43px;letter-spacing:-1.5px}.end-label{position:absolute;left:86px;bottom:100px;font-size:25px;color:#a3e635}.bracket{position:absolute;width:40px;height:40px;border-top:3px solid #a3e635;border-left:3px solid #a3e635;left:49px;top:126px}.end-plane{position:absolute;left:-580px;top:-326px;width:1160px;height:652px;transform-style:preserve-3d}.end-hud{position:absolute;left:-210px;top:145px;width:660px;height:246px;transform-style:preserve-3d}.end-hud img{object-fit:fill}.end-hud .face{border-color:#a3e635}.word{display:inline-block}.micro{position:absolute;right:80px;bottom:48px;font-size:23px;color:#b7bab4}
.hook-top{letter-spacing:-6px}.hook-bottom{letter-spacing:-6px}.word{margin-right:18px}.scene-title,.hud-copy{letter-spacing:-3px}.os-title{font-size:150px;letter-spacing:-5px;z-index:5}.join-title{letter-spacing:-4px}.end-title{letter-spacing:-5px}.hud-shell{left:-500px;top:-120px;width:1000px;height:373px}#os-content{opacity:0}.cap{top:300px;bottom:auto}#focus-front{width:1130px;height:544px;left:-565px;top:-272px}#focus-front .face img{object-fit:fill}.end-hud{top:90px}#hud-callout{bottom:100px}.hud-caption{bottom:100px}
.kicker,.index,.foot,.view-label,.micro,.end-label,.callout{font-size:28px}
</style></head><body>
<div data-hf-id="hf-l8s5" id="root" data-composition-id="kronterm-kinetic" data-width="1920" data-height="1080" data-duration="24" data-fps="30">
<section data-hf-id="hf-ynxv" id="hook" class="clip" data-start="0" data-duration="3.01" data-track-index="0"><div data-hf-id="hf-mcm7" class="content">
<div data-hf-id="hf-71dp" class="kicker">KronTerm</div><div data-hf-id="hf-cljy" class="index">OS + HERMES HUD</div><div data-hf-id="hf-np12" class="line"></div>
